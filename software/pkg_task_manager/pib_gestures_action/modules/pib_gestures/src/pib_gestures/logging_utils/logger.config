[loggers]
keys = root, core, logic, transform, control

[handlers]
keys = coreHandler, logicHandler, transformHandler, controlHandler

[formatters]
keys = defaultFormatter

# root logger
[logger_root]
level = INFO
handlers = 

# logger for core
[logger_core]
level = INFO
handlers = coreHandler
qualname = pib_gestures.core
propagate = 0

# handler for core.log
[handler_coreHandler]
class = FileHandler
level = INFO
formatter = defaultFormatter
args = ('/home/pib/.local/share/pib_gestures/logs/core.log', 'a', 'utf-8')

# logger for utils.logic
[logger_logic]
level = DEBUG
handlers = logicHandler
qualname = pib_gestures.utils.logic
propagate = 0

# handler for logic.log
[handler_logicHandler]
class = FileHandler
level = DEBUG
formatter = defaultFormatter
args = ('/home/pib/.local/share/pib_gestures/logs/logic.log', 'a', 'utf-8')

# logger for utils.transform
[logger_transform]
level = DEBUG
handlers = transformHandler
qualname = pib_gestures.utils.transform
propagate = 0

# handler for transform.log
[handler_transformHandler]
class = FileHandler
level = DEBUG
formatter = defaultFormatter
args = ('/home/pib/.local/share/pib_gestures/logs/transform.log', 'a', 'utf-8')

# logger for utils.pib_control
[logger_control]
level = DEBUG
handlers = controlHandler
qualname = pib_gestures.utils.pib_control
propagate = 0

# handler for control.log
[handler_controlHandler]
class = FileHandler
level = DEBUG
formatter = defaultFormatter
args = ('/home/pib/.local/share/pib_gestures/logs/pib_control.log', 'a', 'utf-8')


# format
[formatter_defaultFormatter]
format = %(name)s - %(levelname)s - %(asctime)s - %(message)s
date = %Y-%m-%d %H:%M:%S
